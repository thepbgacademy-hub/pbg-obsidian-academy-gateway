# PBG Obsidian Academy Gateway production placeholders.
# Copy to a real env file outside git and replace every placeholder before deploy.

NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://replace-with-your-domain.example

DATABASE_URL=postgres://replace-user:replace-password@replace-host:5432/replace-db
SESSION_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_SECRET=replace-with-strong-random-secret
REFRESH_TOKEN_SECRET=replace-with-strong-random-secret

ACADEMY_API_BASE_URL=https://replace-with-academy-api.example
ACADEMY_API_KEY=replace-with-production-api-key

ALLOWED_ORIGINS=https://replace-with-your-domain.example
PBG_DISCUSSION_STATUS_URL=https://replace-with-n8n.example/webhook/pbg-discussion-status
PBG_DISCUSSION_SEEN_URL=https://replace-with-n8n.example/webhook/pbg-discussion-seen
